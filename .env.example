# --- Stripe (required for payments) ---
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create three recurring Prices in Stripe (monthly subscription) and paste IDs here.
# Dashboard → Products → Add product → Recurring → Monthly.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# --- Public site URL (used for Stripe redirect URLs) ---
NEXT_PUBLIC_SITE_URL=https://hirefinalists.com

# --- Supabase (optional, for auth + persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
